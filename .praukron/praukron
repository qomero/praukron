#!/bin/sh
# Zero-install entry point. No packaging, no dependencies, no build step.
#
# The file is read twice. As POSIX sh it finds a Python 3.9 or newer under
# python3 or python and runs itself again with it, so it never depends on
# `python3` being a real interpreter: on Windows that name is often a Microsoft
# Store placeholder. To Python the shell part is one string. PowerShell and cmd
# cannot run this file at all; they run praukron.cmd beside it instead.
''':'
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 &&
      "$py" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    exec "$py" "$0" "$@"
  fi
done
echo "Praukron needs Python 3.9 or newer on PATH as python3 or python." >&2
exit 127
'''

import sys
from pathlib import Path

# A command must leave git status clean: no __pycache__ beside the runtime.
# praukron.cmd and the PATH launcher both run this file, so this covers them.
sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
# Installed, the runtime is copied in beside this script. In a source checkout
# there is no copy, and `src/` one level up is the runtime being developed.
for candidate in (HERE / "runtime", HERE.parent / "src"):
    if (candidate / "praukron" / "cli.py").is_file():
        sys.path.insert(0, str(candidate))
        break
else:  # pragma: no cover
    sys.exit("praukron runtime not found next to this script")

from praukron.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
